{
  "name": "skyfire-solutions-crawler-service-demo",
  "version": "1.0.0",
  "description": "Backend crawler service that executes crawl jobs and pays for protected content with Skyfire KYA+PAY tokens",
  "main": "dist/server.js",
  "engines": {
    "node": ">=18.0.0"
  },
  "scripts": {
    "build": "rimraf dist && npx tsc",
    "prestart": "npm run build",
    "start": "node dist/server.js",
    "preserve": "npm run build",
    "serve": "concurrently \"npx tsc -w\" \"nodemon dist/server.js\"",
    "typecheck": "tsc --noEmit",
    "test": "echo \"Error: no test specified\" && exit 1"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "axios": "1.19.0",
    "convict": "6.2.5",
    "cors": "2.8.6",
    "crawlee": "3.18.1",
    "dotenv": "16.6.1",
    "express": "4.22.2",
    "pusher": "5.3.4"
  },
  "devDependencies": {
    "@types/cors": "2.8.19",
    "@types/express": "4.17.25",
    "@types/node": "20.19.43",
    "concurrently": "8.2.2",
    "nodemon": "3.1.14",
    "rimraf": "6.1.3",
    "typescript": "5.9.3"
  }
}

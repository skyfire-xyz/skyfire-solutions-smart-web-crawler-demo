{
  "name": "skyfire-solutions-crawler-bot-protection-proxy",
  "version": "1.0.0",
  "description": "Node.js/Express proxy service with Redis-based bot protection and usage tracking",
  "main": "dist/index.js",
  "engines": {
    "node": ">=18.0.0"
  },
  "scripts": {
    "start": "node dist/index.js",
    "dev": "nodemon --watch src --ext ts --exec tsx src/index.ts",
    "build": "tsc",
    "postbuild": "echo 'Build completed successfully'",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src/**/*.ts",
    "lint:fix": "eslint src/**/*.ts --fix",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "create-token": "tsx scripts/create-token.ts"
  },
  "keywords": [
    "proxy",
    "bot-protection",
    "redis",
    "express",
    "typescript"
  ],
  "author": "kmiyauchi",
  "license": "MIT",
  "dependencies": {
    "cors": "2.8.6",
    "dd-trace": "5.121.0",
    "dotenv": "17.4.2",
    "express": "5.2.1",
    "helmet": "8.3.0",
    "http-proxy-middleware": "3.0.7",
    "ioredis": "5.11.1",
    "jose": "6.2.8",
    "pino": "9.14.0",
    "pino-datadog-transport": "3.0.6",
    "pino-pretty": "13.1.3",
    "validator": "13.15.35"
  },
  "devDependencies": {
    "@babel/preset-env": "7.29.7",
    "@babel/preset-typescript": "7.29.7",
    "@eslint/js": "9.30.1",
    "@jest/globals": "30.0.4",
    "@types/cors": "2.8.19",
    "@types/express": "5.0.6",
    "@types/jest": "29.5.8",
    "@types/node": "24.13.3",
    "@types/validator": "13.15.10",
    "@typescript-eslint/eslint-plugin": "8.35.1",
    "@typescript-eslint/parser": "8.35.1",
    "babel-jest": "30.0.4",
    "eslint": "9.30.1",
    "globals": "14.0.0",
    "jest": "29.7.0",
    "nodemon": "3.1.14",
    "ts-jest": "29.4.0",
    "tsx": "4.23.12",
    "typescript": "5.9.3"
  }
}
